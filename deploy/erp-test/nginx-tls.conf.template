user frappe;
worker_processes 1;
pid /tmp/jifeng-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  sendfile on;
  client_max_body_size 20m;
  upstream frappe_backend { server backend:8000; }
  upstream frappe_socketio { server websocket:9000; }
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 8080;
    server_name __PUBLIC_IP__;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://__PUBLIC_IP__$request_uri; }
  }
  server {
    listen 8443 ssl;
    server_name __PUBLIC_IP__;
    ssl_certificate /etc/letsencrypt/live/__PUBLIC_IP__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_IP__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options nosniff always;
    root /home/frappe/frappe-bench/sites;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location /assets/ { alias /home/frappe/frappe-bench/sites/assets/; expires 7d; }
    location ~ ^/protected/(.*) { internal; try_files /jifeng-erp-test.localhost/$1 =404; }
    location /socket.io {
      proxy_pass http://frappe_socketio;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Origin https://__PUBLIC_IP__;
      proxy_set_header Host $host;
      proxy_set_header X-Frappe-Site-Name jifeng-erp-test.localhost;
    }
    location / {
      proxy_pass http://frappe_backend;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Frappe-Site-Name jifeng-erp-test.localhost;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_read_timeout 120s;
    }
  }
}
