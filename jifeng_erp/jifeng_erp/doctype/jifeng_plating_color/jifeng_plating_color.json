{
 "doctype": "DocType",
 "name": "Jifeng Plating Color",
 "module": "Jifeng ERP",
 "autoname": "format:JF-PL-C-{YYYY}-{#####}",
 "title_field": "value",
 "search_fields": "code,value,color_system,remarks,legacy_number,abbreviation",
 "track_changes": 1,
 "field_order": [
  "company",
  "dictionary_type",
  "legacy_number",
  "code",
  "value",
  "color_system",
  "remarks",
  "abbreviation",
  "inactive",
  "numbering_mode",
  "request_id",
  "request_digest"
 ],
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "公司",
   "options": "Company",
   "reqd": 1,
   "set_only_once": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "dictionary_type",
   "fieldtype": "Select",
   "label": "档案类型",
   "options": "镀色",
   "default": "镀色",
   "reqd": 1,
   "set_only_once": 1,
   "in_list_view": 1,
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "legacy_number",
   "fieldtype": "Data",
   "label": "编号",
   "in_list_view": 1,
   "no_copy": 1,
   "read_only": 1,
   "description": "保存时自动生成，暂定编号仅供参考。"
  },
  {
   "fieldname": "code",
   "fieldtype": "Data",
   "label": "代码",
   "in_list_view": 1,
   "description": "代码生成条码时用。"
  },
  {
   "fieldname": "value",
   "fieldtype": "Data",
   "label": "名称",
   "reqd": 1,
   "in_list_view": 1,
   "description": "请填写名称。"
  },
  {
   "fieldname": "color_system",
   "fieldtype": "Data",
   "label": "色系",
   "in_list_view": 1,
   "description": "按实际色系填写。"
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "备注",
   "description": "保存备注原文。"
  },
  {
   "fieldname": "abbreviation",
   "fieldtype": "Data",
   "label": "简拼",
   "read_only": 1,
   "description": "现有简拼只读显示。"
  },
  {
   "fieldname": "inactive",
   "fieldtype": "Check",
   "label": "停用",
   "default": "0",
   "in_list_view": 1,
   "description": "停用后默认查询不显示，历史记录保留。"
  },
  {
   "fieldname": "numbering_mode",
   "fieldtype": "Data",
   "label": "服务器编号模式",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  },
  {
   "fieldname": "request_id",
   "fieldtype": "Data",
   "label": "新建请求身份",
   "hidden": 1,
   "read_only": 1,
   "unique": 1,
   "no_copy": 1,
   "print_hide": 1
  },
  {
   "fieldname": "request_digest",
   "fieldtype": "Data",
   "label": "新建请求摘要",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "select": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "select": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Sales User",
   "read": 1,
   "select": 1
  }
 ]
}
