{
 "doctype": "DocType",
 "name": "Jifeng HR Dictionary",
 "module": "Jifeng ERP",
 "autoname": "format:JF-HR-D-{YYYY}-{#####}",
 "title_field": "value",
 "search_fields": "value",
 "track_changes": 1,
 "field_order": ["company", "dictionary_type", "value", "inactive", "dictionary_key"],
 "fields": [
  {"fieldname": "company", "fieldtype": "Link", "label": "公司", "options": "Company", "reqd": 1, "set_only_once": 1, "in_list_view": 1},
  {"fieldname": "dictionary_type", "fieldtype": "Select", "label": "人事词典类型", "options": "专长\n文化\n民族", "reqd": 1, "set_only_once": 1, "in_list_view": 1},
  {"fieldname": "value", "fieldtype": "Data", "label": "词典内容", "reqd": 1, "set_only_once": 1, "in_list_view": 1, "description": "创建后原文固定；修改请停用原词条并新增，不自动修改已有人员档案。"},
  {"fieldname": "inactive", "fieldtype": "Check", "label": "停用", "default": "0", "in_list_view": 1, "description": "停用仅影响新选择，已有专长、文化或民族原文保持不变。"},
  {"fieldname": "dictionary_key", "fieldtype": "Data", "label": "人事词条唯一身份", "hidden": 1, "read_only": 1, "unique": 1, "no_copy": 1, "print_hide": 1}
 ],
 "permissions": [
  {"role": "HR User", "read": 1, "select": 1},
  {"role": "HR Manager", "read": 1, "select": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1},
  {"role": "System Manager", "read": 1, "select": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1}
 ]
}
