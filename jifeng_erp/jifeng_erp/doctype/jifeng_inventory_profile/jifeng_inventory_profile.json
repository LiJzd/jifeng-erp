{
 "doctype": "DocType",
 "name": "Jifeng Inventory Profile",
 "module": "Jifeng ERP",
 "autoname": "format:JF-INV-P-{YYYY}-{#####}",
 "title_field": "display_name",
 "search_fields": "legacy_number,legacy_code,old_number,display_name,item_code,specification",
 "track_changes": 1,
 "field_order": [
  "company", "archive_kind", "item_code", "legacy_number", "legacy_code", "major_category", "minor_category",
  "old_number", "specification", "shape", "color", "display_name", "location", "material", "display_uom",
  "list_price", "processing_price", "weight", "supplier", "upper_limit", "lower_limit", "conversion_uom",
  "conversion_value", "owner_name", "region", "notes", "inactive", "request_id", "request_digest"
 ],
 "fields": [
  {"fieldname": "company", "fieldtype": "Link", "label": "公司", "options": "Company", "reqd": 1, "set_only_once": 1, "in_list_view": 1},
  {"fieldname": "archive_kind", "fieldtype": "Select", "label": "档案种类", "options": "物料\n材料", "reqd": 1, "read_only": 1, "in_list_view": 1},
  {"fieldname": "item_code", "fieldtype": "Link", "label": "真实业务商品", "options": "Item", "reqd": 1, "unique": 1, "read_only": 1},
  {"fieldname": "legacy_number", "fieldtype": "Data", "label": "编号", "reqd": 1, "in_list_view": 1},
  {"fieldname": "legacy_code", "fieldtype": "Data", "label": "代码", "in_list_view": 1},
  {"fieldname": "major_category", "fieldtype": "Data", "label": "大类", "in_list_view": 1},
  {"fieldname": "minor_category", "fieldtype": "Data", "label": "小类"},
  {"fieldname": "old_number", "fieldtype": "Data", "label": "旧号"},
  {"fieldname": "specification", "fieldtype": "Small Text", "label": "规格"},
  {"fieldname": "shape", "fieldtype": "Data", "label": "形状", "depends_on": "eval:doc.archive_kind=='材料'"},
  {"fieldname": "color", "fieldtype": "Data", "label": "颜色", "depends_on": "eval:doc.archive_kind=='材料'"},
  {"fieldname": "display_name", "fieldtype": "Data", "label": "名称", "reqd": 1, "in_list_view": 1, "description": "档案名称；保存已有档案不改写共享业务商品名称。"},
  {"fieldname": "location", "fieldtype": "Data", "label": "库位", "description": "保存旧档案原文，不替代正式库存仓库。"},
  {"fieldname": "material", "fieldtype": "Data", "label": "材质", "depends_on": "eval:doc.archive_kind=='物料'"},
  {"fieldname": "display_uom", "fieldtype": "Data", "label": "单位", "description": "档案单位原文；实际库存使用关联商品的真实库存单位。"},
  {"fieldname": "list_price", "fieldtype": "Currency", "label": "单价", "options": "Company:company:default_currency", "non_negative": 1, "description": "档案参考价，不生成价格表或财务凭证。"},
  {"fieldname": "processing_price", "fieldtype": "Currency", "label": "加工价", "options": "Company:company:default_currency", "non_negative": 1},
  {"fieldname": "weight", "fieldtype": "Float", "label": "重量", "precision": "6", "non_negative": 1},
  {"fieldname": "supplier", "fieldtype": "Link", "label": "供应商", "options": "Supplier"},
  {"fieldname": "upper_limit", "fieldtype": "Float", "label": "上限", "precision": "6", "non_negative": 1},
  {"fieldname": "lower_limit", "fieldtype": "Float", "label": "下限", "precision": "6", "non_negative": 1},
  {"fieldname": "conversion_uom", "fieldtype": "Link", "label": "换算单位", "options": "UOM"},
  {"fieldname": "conversion_value", "fieldtype": "Float", "label": "换算值", "default": "1", "reqd": 1, "precision": "6", "description": "仅保存旧档案参考值；换算方向核实前不用于库存单位换算。"},
  {"fieldname": "owner_name", "fieldtype": "Data", "label": "负责"},
  {"fieldname": "region", "fieldtype": "Data", "label": "区域"},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "备注"},
  {"fieldname": "inactive", "fieldtype": "Check", "label": "停用", "default": "0", "in_list_view": 1, "description": "本公司档案状态，不改写共享业务商品的停用状态。"},
  {"fieldname": "request_id", "fieldtype": "Data", "label": "新建请求身份", "unique": 1, "hidden": 1, "read_only": 1, "no_copy": 1, "print_hide": 1},
  {"fieldname": "request_digest", "fieldtype": "Data", "label": "新建请求核对", "hidden": 1, "read_only": 1, "no_copy": 1, "print_hide": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1},
  {"role": "Stock Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1},
  {"role": "Stock User", "read": 1, "report": 1, "print": 1},
  {"role": "Manufacturing Manager", "read": 1, "report": 1, "print": 1}
 ]
}
