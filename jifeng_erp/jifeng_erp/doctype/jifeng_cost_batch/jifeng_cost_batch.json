{
 "doctype": "DocType",
 "name": "Jifeng Cost Batch",
 "module": "Jifeng ERP",
 "istable": 1,
 "editable_grid": 1,
 "field_order": [
  "receipt_type",
  "reference_no",
  "source_receipt",
  "source_receipt_item",
  "source_manufacture",
  "source_loss_issue",
  "received_qty",
  "good_qty",
  "rework_qty",
  "lost_qty",
  "pending_qty",
  "extra_processing_amount",
  "estimated_cost"
 ],
 "fields": [
  {
   "fieldname": "receipt_type",
   "fieldtype": "Select",
   "label": "回货类型",
   "options": "首次回货\n返工回货\n待检处理",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "reference_no",
   "fieldtype": "Data",
   "label": "回货单号",
   "in_list_view": 1
  },
  {
   "fieldname": "source_receipt",
   "fieldtype": "Link",
   "label": "来源委外收货单",
   "options": "Subcontracting Receipt",
   "read_only": 1
  },
  {
   "fieldname": "source_receipt_item",
   "fieldtype": "Data",
   "label": "来源收货明细行",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "source_manufacture",
   "fieldtype": "Link",
   "label": "来源制造入库单",
   "options": "Stock Entry",
   "read_only": 1,
   "description": "按制造单全部终成品入库量与父单确认损耗核对；工艺损耗只计一次。"
  },
  {
   "fieldname": "source_loss_issue",
   "fieldtype": "Link",
   "label": "来源制造损耗出库单",
   "options": "Stock Entry",
   "read_only": 1,
   "description": "独立损耗来源没有成品入库；覆盖量全数列为损耗，实际材料费用按出库凭证计一次。"
  },
  {
   "fieldname": "received_qty",
   "fieldtype": "Float",
   "label": "回货数量",
   "reqd": 1,
   "in_list_view": 1,
   "precision": "6"
  },
  {
   "fieldname": "good_qty",
   "fieldtype": "Float",
   "label": "合格数量",
   "in_list_view": 1,
   "precision": "6"
  },
  {
   "fieldname": "rework_qty",
   "fieldtype": "Float",
   "label": "返工数量",
   "precision": "6"
  },
  {
   "fieldname": "lost_qty",
   "fieldtype": "Float",
   "label": "损耗数量",
   "precision": "6"
  },
  {
   "fieldname": "pending_qty",
   "fieldtype": "Float",
   "label": "待检数量",
   "precision": "6"
  },
  {
   "fieldname": "extra_processing_amount",
   "fieldtype": "Currency",
   "label": "未计入收货凭证的追加加工费"
  },
  {
   "fieldname": "estimated_cost",
   "fieldtype": "Currency",
   "label": "本批合格品试算金额",
   "read_only": 1
  }
 ],
 "permissions": []
}
