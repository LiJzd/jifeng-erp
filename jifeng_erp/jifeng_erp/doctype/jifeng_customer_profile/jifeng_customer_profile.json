{
 "doctype": "DocType",
 "name": "Jifeng Customer Profile",
 "module": "Jifeng ERP",
 "autoname": "format:JF-CUST-P-{YYYY}-{#####}",
 "title_field": "display_name",
 "search_fields": "legacy_number,legacy_code,display_name",
 "track_changes": 1,
 "field_order": [
  "company",
  "archive_kind",
  "customer",
  "legacy_number",
  "legacy_code",
  "display_name",
  "category",
  "grade",
  "customer_kind",
  "discount",
  "region",
  "province",
  "district",
  "salesperson",
  "contact_name",
  "tax_number",
  "company_text",
  "mobile",
  "legal_person",
  "address",
  "notes",
  "inactive",
  "numbering_mode",
  "binding_key",
  "request_id",
  "request_digest"
 ],
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "归属公司",
   "options": "Company",
   "reqd": 1,
   "set_only_once": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "archive_kind",
   "fieldtype": "Select",
   "label": "档案种类",
   "options": "销售客户\n订单客户",
   "reqd": 1,
   "set_only_once": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "关联原生客户",
   "options": "Customer",
   "reqd": 1,
   "set_only_once": 1,
   "description": "新建正常原生客户或显式关联已有客户；档案原文不会改写共享客户、联系人或地址。"
  },
  {
   "fieldname": "legacy_number",
   "fieldtype": "Data",
   "label": "编号",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1,
   "description": "本系统按归属公司及模块独立编号。新增显示下一号参考，保存以服务器最终号为准；不推定旧系统编号规则。"
  },
  {
   "fieldname": "legacy_code",
   "fieldtype": "Data",
   "label": "代码"
  },
  {
   "fieldname": "display_name",
   "fieldtype": "Data",
   "label": "名称",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "category",
   "fieldtype": "Link",
   "label": "分类",
   "options": "Jifeng Customer Type"
  },
  {
   "fieldname": "grade",
   "fieldtype": "Link",
   "label": "级别",
   "options": "Jifeng Customer Type"
  },
  {
   "fieldname": "customer_kind",
   "fieldtype": "Link",
   "label": "类型",
   "options": "Jifeng Customer Type",
   "depends_on": "eval:doc.archive_kind === \"销售客户\""
  },
  {
   "fieldname": "discount",
   "fieldtype": "Data",
   "label": "折扣",
   "depends_on": "eval:doc.archive_kind === \"销售客户\"",
   "description": "原文文本，尚未映射定价或折扣计算。"
  },
  {
   "fieldname": "region",
   "fieldtype": "Data",
   "label": "区域"
  },
  {
   "fieldname": "province",
   "fieldtype": "Data",
   "label": "省份"
  },
  {
   "fieldname": "district",
   "fieldtype": "Data",
   "label": "地区"
  },
  {
   "fieldname": "salesperson",
   "fieldtype": "Data",
   "label": "导购"
  },
  {
   "fieldname": "contact_name",
   "fieldtype": "Data",
   "label": "联系"
  },
  {
   "fieldname": "tax_number",
   "fieldtype": "Data",
   "label": "税号"
  },
  {
   "fieldname": "company_text",
   "fieldtype": "Data",
   "label": "公司",
   "description": "旧界面的公司原文，与当前归属公司独立。"
  },
  {
   "fieldname": "mobile",
   "fieldtype": "Data",
   "label": "手机"
  },
  {
   "fieldname": "legal_person",
   "fieldtype": "Data",
   "label": "法人"
  },
  {
   "fieldname": "address",
   "fieldtype": "Data",
   "label": "地址"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Data",
   "label": "备注"
  },
  {
   "fieldname": "inactive",
   "fieldtype": "Check",
   "label": "停用",
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "numbering_mode",
   "fieldtype": "Data",
   "label": "编号模式",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  },
  {
   "fieldname": "binding_key",
   "fieldtype": "Data",
   "label": "客户关联身份",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1,
   "unique": 1
  },
  {
   "fieldname": "request_id",
   "fieldtype": "Data",
   "label": "新建请求身份",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1,
   "unique": 1
  },
  {
   "fieldname": "request_digest",
   "fieldtype": "Data",
   "label": "新建请求内容校验",
   "hidden": 1,
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "create": 1,
   "write": 1,
   "select": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "create": 1,
   "write": 1,
   "select": 1
  },
  {
   "role": "Sales Master Manager",
   "read": 1,
   "create": 1,
   "write": 1,
   "select": 1
  },
  {
   "role": "Sales User",
   "read": 1,
   "select": 1
  }
 ]
}
