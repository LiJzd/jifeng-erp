{
 "doctype": "DocType",
 "name": "Jifeng Wage Entry",
 "module": "Jifeng ERP",
 "autoname": "format:JF-WAGE-{YYYY}-{#####}",
 "title_field": "employee_name",
 "search_fields": "employee,employee_name,operation,flow_order,work_order,job_card",
 "track_changes": 1,
 "is_submittable": 1,
 "allow_import": 1,
 "field_order": [
  "employee", "employee_name", "company", "operation", "work_date", "payroll_date",
  "flow_order", "work_order", "job_card", "wage_allocation", "wage_allocation_employee", "salary_component", "calculation_section",
  "quantity", "stock_uom", "piece_rate", "piece_rate_reference", "piece_rate_reference_version", "piece_amount", "hours", "hourly_rate",
  "time_amount", "extra_amount", "total_amount", "notes", "piece_worker_qualified", "piece_worker_qualification_status", "piece_worker_qualification_source", "piece_worker_qualification_version", "amended_from", "workbench_request_key", "workbench_request_fingerprint"
 ],
 "fields": [
  {"fieldname": "employee", "fieldtype": "Link", "label": "员工", "options": "Employee", "reqd": 1, "in_list_view": 1},
  {"fieldname": "employee_name", "fieldtype": "Data", "label": "姓名", "read_only": 1, "in_list_view": 1},
  {"fieldname": "company", "fieldtype": "Link", "label": "公司", "options": "Company", "reqd": 1, "in_list_view": 1},
  {"fieldname": "operation", "fieldtype": "Data", "label": "工序", "reqd": 1, "in_list_view": 1},
  {"fieldname": "work_date", "fieldtype": "Date", "label": "工作日期", "reqd": 1, "default": "Today", "in_list_view": 1},
  {"fieldname": "payroll_date", "fieldtype": "Date", "label": "计薪日期", "reqd": 1, "default": "Today"},
  {"fieldname": "flow_order", "fieldtype": "Link", "label": "流程单", "options": "Jifeng Flow Order"},
  {"fieldname": "work_order", "fieldtype": "Link", "label": "生产工单", "options": "Work Order"},
  {"fieldname": "job_card", "fieldtype": "Link", "label": "工序报工单", "options": "Job Card", "description": "关联后在审核时核对报工单已提交且员工存在报工时间记录。"},
  {"fieldname": "wage_allocation", "fieldtype": "Link", "label": "工资分配", "options": "Jifeng Wage Allocation", "read_only": 1},
  {"fieldname": "wage_allocation_employee", "fieldtype": "Data", "label": "来源员工行", "read_only": 1, "hidden": 1},
  {"fieldname": "salary_component", "fieldtype": "Link", "label": "收入工资项目", "options": "Salary Component", "reqd": 1},
  {"fieldname": "calculation_section", "fieldtype": "Section Break", "label": "计薪明细"},
  {"fieldname": "quantity", "fieldtype": "Float", "label": "计件数量", "precision": "6", "default": "0"},
  {"fieldname": "stock_uom", "fieldtype": "Link", "label": "计件单位", "options": "UOM"},
  {"fieldname": "piece_rate", "fieldtype": "Currency", "label": "计件工价", "precision": "6", "options": "Company:company:default_currency", "default": "0"},
  {"fieldname": "piece_rate_reference", "fieldtype": "Data", "label": "历史工价来源", "read_only": 1, "no_copy": 1, "description": "明确调用历史工价后记录原计薪编号；审核保留本次采用的工价。"},
  {"fieldname": "piece_rate_reference_version", "fieldtype": "Data", "label": "历史工价来源版本", "read_only": 1, "hidden": 1, "no_copy": 1},
  {"fieldname": "piece_amount", "fieldtype": "Currency", "label": "计件金额", "options": "Company:company:default_currency", "read_only": 1},
  {"fieldname": "hours", "fieldtype": "Float", "label": "计时小时", "precision": "6", "default": "0"},
  {"fieldname": "hourly_rate", "fieldtype": "Currency", "label": "计时单价", "precision": "6", "options": "Company:company:default_currency", "default": "0"},
  {"fieldname": "time_amount", "fieldtype": "Currency", "label": "计时金额", "options": "Company:company:default_currency", "read_only": 1},
  {"fieldname": "extra_amount", "fieldtype": "Currency", "label": "附加费", "options": "Company:company:default_currency", "default": "0"},
  {"fieldname": "total_amount", "fieldtype": "Currency", "label": "计薪合计", "options": "Company:company:default_currency", "read_only": 1, "in_list_view": 1},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "备注"},
  {"fieldname": "piece_worker_qualified", "fieldtype": "Check", "label": "计件资格已核实", "read_only": 1, "hidden": 1, "no_copy": 1},
  {"fieldname": "piece_worker_qualification_status", "fieldtype": "Select", "label": "计件资格核实状态", "options": "\n已核实\n历史未记录\n不适用", "description": "审核前按当前人员档案核实；早期已审核记录没有资格快照时保留为历史未记录，不推定当时工资方式。", "read_only": 1, "no_copy": 1},
  {"fieldname": "piece_worker_qualification_source", "fieldtype": "Data", "label": "计件资格来源摘要", "read_only": 1, "hidden": 1, "no_copy": 1, "permlevel": 1},
  {"fieldname": "piece_worker_qualification_version", "fieldtype": "Data", "label": "计件资格版本摘要", "read_only": 1, "hidden": 1, "no_copy": 1, "permlevel": 1},
  {"fieldname": "amended_from", "fieldtype": "Link", "label": "修改自", "options": "Jifeng Wage Entry", "read_only": 1, "no_copy": 1, "print_hide": 1},
  {"fieldname": "workbench_request_key", "fieldtype": "Data", "label": "工资录入请求", "read_only": 1, "hidden": 1, "unique": 1, "no_copy": 1},
  {"fieldname": "workbench_request_fingerprint", "fieldtype": "Data", "label": "工资录入请求内容", "read_only": 1, "hidden": 1, "no_copy": 1}
 ],
 "permissions": [
  {"role": "HR User", "read": 1, "write": 1, "create": 1, "report": 1, "print": 1},
  {"role": "HR Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "report": 1, "export": 1, "print": 1},
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "report": 1, "export": 1, "print": 1},
  {"role": "System Manager", "permlevel": 1, "read": 1}
 ]
}
