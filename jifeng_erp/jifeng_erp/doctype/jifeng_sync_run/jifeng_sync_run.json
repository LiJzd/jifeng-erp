{
 "doctype": "DocType",
 "name": "Jifeng Sync Run",
 "module": "Jifeng ERP",
 "track_changes": 1,
 "editable_grid": 1,
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "Stock Manager",
   "read": 1,
   "report": 1
  }
 ],
 "autoname": "format:JF-SYNC-{YYYY}-{#####}",
 "fields": [
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "状态",
   "options": "运行中\n完成\n失败",
   "in_list_view": 1
  },
  {
   "fieldname": "started_at",
   "fieldtype": "Datetime",
   "label": "开始时间"
  },
  {
   "fieldname": "finished_at",
   "fieldtype": "Datetime",
   "label": "结束时间"
  },
  {
   "fieldname": "order_count",
   "fieldtype": "Int",
   "label": "处理订单数"
  },
  {
   "fieldname": "sku_count",
   "fieldtype": "Int",
   "label": "处理商品数"
  },
  {
   "fieldname": "message",
   "fieldtype": "Small Text",
   "label": "结果摘要"
  }
 ],
 "field_order": [
  "status",
  "started_at",
  "finished_at",
  "order_count",
  "sku_count",
  "message"
 ]
}
