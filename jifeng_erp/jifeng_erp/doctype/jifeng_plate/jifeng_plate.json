{
 "doctype": "DocType",
 "name": "Jifeng Plate",
 "module": "Jifeng ERP",
 "autoname": "format:JF-PLATE-{YYYY}-{#####}",
 "title_field": "plate_no",
 "search_fields": "legacy_number,plate_type,product_code,plate_no,item_code,location,maker,modeler",
 "track_changes": 1,
 "allow_import": 1,
 "field_order": [
  "company", "legacy_number", "plate_type", "product_code", "assessment_score", "maker",
  "quantity", "notes", "location", "retired", "legacy_copy", "copy_from",
  "plate_no", "item_code", "image", "plate_date", "modeler", "reference_cost",
  "retired_date", "retired_reason"
 ],
 "fields": [
  {"fieldname": "company", "fieldtype": "Link", "label": "公司", "options": "Company", "reqd": 1, "in_list_view": 1},
  {"fieldname": "legacy_number", "fieldtype": "Data", "label": "编号原文", "description": "单独保存历史录入编号，不从版种编号或系统主键带入，也不自动生成旧编号。"},
  {"fieldname": "plate_type", "fieldtype": "Data", "label": "类型原文", "description": "保留类型文字，不推定旧选择词典或映射为版种编号。"},
  {"fieldname": "product_code", "fieldtype": "Data", "label": "产品编号原文", "description": "与关联商品编码独立保存，不自动匹配商品。"},
  {"fieldname": "assessment_score", "fieldtype": "Data", "label": "考核分原文", "description": "新建未提供时保存为1，明确留空则保留空；历史空值不回填。不参与工资或金额计算。"},
  {"fieldname": "quantity", "fieldtype": "Data", "label": "数量原文", "description": "按旧文本输入保存，无默认数量，不生成或转换库存。"},
  {"fieldname": "legacy_copy", "fieldtype": "Check", "label": "复制勾选记录", "description": "只保留旧录入的勾选状态，不执行复制；复制来源另行明确填写。"},
  {"fieldname": "copy_from", "fieldtype": "Link", "label": "复制来源版种", "options": "Jifeng Plate", "description": "只记录同公司可读的来源版种，不自动复制字段或生成记录。"},
  {"fieldname": "plate_no", "fieldtype": "Data", "label": "版种编号", "reqd": 1, "unique": 1, "in_list_view": 1, "description": "本系统既有唯一身份；与历史编号、类型及产品编号分别保存，不相互回填。"},
  {"fieldname": "item_code", "fieldtype": "Link", "label": "关联商品", "options": "Item", "in_list_view": 1},
  {"fieldname": "image", "fieldtype": "Attach Image", "label": "版种图片"},
  {"fieldname": "plate_date", "fieldtype": "Date", "label": "建档日期", "reqd": 1, "default": "Today", "in_list_view": 1},
  {"fieldname": "maker", "fieldtype": "Link", "label": "制版人", "options": "Employee"},
  {"fieldname": "modeler", "fieldtype": "Link", "label": "建模人", "options": "Employee"},
  {"fieldname": "reference_cost", "fieldtype": "Currency", "label": "参考制作费用", "options": "Company:company:default_currency", "description": "参考资料；不生成财务凭证。"},
  {"fieldname": "location", "fieldtype": "Data", "label": "存放位置"},
  {"fieldname": "retired", "fieldtype": "Check", "label": "已停用", "in_list_view": 1},
  {"fieldname": "retired_date", "fieldtype": "Date", "label": "停用日期", "depends_on": "eval:doc.retired==1", "mandatory_depends_on": "eval:doc.retired==1"},
  {"fieldname": "retired_reason", "fieldtype": "Small Text", "label": "停用原因", "depends_on": "eval:doc.retired==1"},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "说明"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1},
  {"role": "Manufacturing Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1},
  {"role": "Stock Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1, "print": 1}
 ]
}
