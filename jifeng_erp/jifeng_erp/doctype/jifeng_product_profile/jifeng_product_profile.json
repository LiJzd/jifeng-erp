{
 "doctype": "DocType",
 "name": "Jifeng Product Profile",
 "module": "Jifeng ERP",
 "track_changes": 1,
 "editable_grid": 1,
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "Stock Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "Manufacturing Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "print": 1
  }
 ],
 "autoname": "field:item_code",
 "fields": [
  {"fieldname": "identity_section", "fieldtype": "Section Break", "label": "商品基础信息"},
  {
   "fieldname": "item_code",
   "fieldtype": "Link",
   "label": "商品编码",
   "options": "Item",
   "reqd": 1,
   "unique": 1,
   "read_only_depends_on": "eval:!doc.__islocal",
   "in_list_view": 1
  },
  {
   "fieldname": "image",
   "fieldtype": "Attach Image",
   "label": "业务商品图片",
   "fetch_from": "item_code.image",
   "read_only": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "公司",
   "options": "Company",
   "read_only_depends_on": "eval:!doc.__islocal",
   "reqd": 1
  },
  {
   "fieldname": "bom",
   "fieldtype": "Link",
   "label": "标准物料清单",
   "options": "BOM"
  },
  {
   "fieldname": "supplier_product_code",
   "fieldtype": "Data",
   "label": "供应商商品编码",
   "in_list_view": 1
  },
  {
   "fieldname": "supplier",
   "fieldtype": "Link",
   "label": "供应商",
   "options": "Supplier"
  },
  {
   "fieldname": "material",
   "fieldtype": "Data",
   "label": "材质"
  },
  {
   "fieldname": "specification",
   "fieldtype": "Small Text",
   "label": "规格"
  },
  {"fieldname": "product_name", "fieldtype": "Data", "label": "业务商品名称", "fetch_from": "item_code.item_name", "read_only": 1},
  {"fieldname": "stock_uom", "fieldtype": "Link", "label": "库存单位", "options": "UOM", "fetch_from": "item_code.stock_uom", "read_only": 1},
  {"fieldname": "legacy_section", "fieldtype": "Section Break", "label": "产品档案原文", "description": "独立保留旧产品资料，不更改业务商品、库存单位或默认工艺要求。"},
  {"fieldname": "legacy_number", "fieldtype": "Data", "label": "编号原文"},
  {"fieldname": "legacy_code", "fieldtype": "Data", "label": "代码原文"},
  {"fieldname": "display_name", "fieldtype": "Data", "label": "名称原文"},
  {"fieldname": "display_uom", "fieldtype": "Data", "label": "单位原文"},
  {"fieldname": "legacy_remarks", "fieldtype": "Small Text", "label": "备注原文"},
  {"fieldname": "profile_image", "fieldtype": "Attach Image", "label": "产品档案图片", "read_only_depends_on": "eval:doc.__islocal", "description": "先保存档案，再上传绑定本档案的私有图片。"},
  {"fieldname": "old_number", "fieldtype": "Data", "label": "旧号"},
  {"fieldname": "major_category", "fieldtype": "Data", "label": "大类", "in_list_view": 1},
  {"fieldname": "minor_category", "fieldtype": "Data", "label": "小类"},
  {"fieldname": "category", "fieldtype": "Link", "label": "类别主项来源", "options": "Jifeng Product Category", "no_copy": 1, "description": "本系统明确类别关联；改选时仅快照大类名称，不推导旧代码、材质或单位。历史原文不随类别改名。"},
  {"fieldname": "category_detail", "fieldtype": "Link", "label": "类别明细来源", "options": "Jifeng Product Category Detail", "no_copy": 1, "description": "显式选择本公司当前大类下未停用明细；仅快照小类名称。"},
  {"fieldname": "brand", "fieldtype": "Data", "label": "品牌"},
  {"fieldname": "style", "fieldtype": "Data", "label": "风格"},
  {"fieldname": "source", "fieldtype": "Data", "label": "来源"},
  {"fieldname": "design_section", "fieldtype": "Section Break", "label": "设计与专利"},
  {"fieldname": "shared_version", "fieldtype": "Data", "label": "共版"},
  {"fieldname": "patent_number", "fieldtype": "Data", "label": "专利号"},
  {"fieldname": "patent_image", "fieldtype": "Attach Image", "label": "专利图片", "read_only_depends_on": "eval:doc.__islocal", "description": "先保存档案再上传精确绑定本字段的私有图片；未修改历史值可保留但不自动授权下载。"},
  {"fieldname": "designer", "fieldtype": "Data", "label": "设计员"},
  {"fieldname": "pattern_maker", "fieldtype": "Data", "label": "打版员"},
  {"fieldname": "modeler", "fieldtype": "Data", "label": "建模员"},
  {"fieldname": "owner_name", "fieldtype": "Data", "label": "负责人"},
  {"fieldname": "region", "fieldtype": "Data", "label": "区域"},
  {"fieldname": "pricing_section", "fieldtype": "Section Break", "label": "参考价格与重量"},
  {"fieldname": "list_price", "fieldtype": "Currency", "label": "参考单价", "options": "Company:company:default_currency", "description": "档案参考值，不代替订单成交价。"},
  {"fieldname": "blank_price", "fieldtype": "Currency", "label": "毛胚价", "options": "Company:company:default_currency"},
  {"fieldname": "weight", "fieldtype": "Float", "label": "重量", "precision": "6"},
  {"fieldname": "silver_weight", "fieldtype": "Float", "label": "银重", "precision": "6"},
  {"fieldname": "stone_weight", "fieldtype": "Float", "label": "石重", "precision": "6"},
  {"fieldname": "inactive", "fieldtype": "Check", "label": "本公司档案停用", "in_list_view": 1, "description": "只标记集沣档案，不更改 ERPNext 商品主数据。"},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "注意事项"},
  {"fieldname": "recipe_section", "fieldtype": "Section Break", "label": "默认要求与工艺"},
  {
   "fieldname": "requirements",
   "fieldtype": "Text",
   "label": "默认定制/工艺要求"
  },
  {
   "fieldname": "packaging",
   "fieldtype": "Text",
   "label": "默认包装要求"
  },
  {
   "fieldname": "materials",
   "fieldtype": "Table",
   "label": "物料分析",
   "options": "Jifeng Material Line"
  },
  {
   "fieldname": "operations",
   "fieldtype": "Table",
   "label": "工序顺序与加工费",
   "options": "Jifeng Operation Line"
  },
  {
   "fieldname": "material_unit_cost",
   "fieldtype": "Currency",
   "label": "单件材料费",
   "read_only": 1,
   "options": "Company:company:default_currency",
   "precision": "6"
  },
  {
   "fieldname": "processing_unit_cost",
   "fieldtype": "Currency",
   "label": "单件加工费",
   "read_only": 1,
   "options": "Company:company:default_currency",
   "precision": "6"
  },
  {"fieldname": "request_id", "fieldtype": "Data", "label": "新建请求身份", "hidden": 1, "read_only": 1, "unique": 1, "no_copy": 1, "print_hide": 1},
  {"fieldname": "request_digest", "fieldtype": "Data", "label": "初始请求摘要", "hidden": 1, "read_only": 1, "no_copy": 1, "print_hide": 1},
  {"fieldname": "creation_mode", "fieldtype": "Select", "label": "业务商品创建来源", "options": "\nnew_item\nexisting_item\nnative_existing_item", "hidden": 1, "read_only": 1, "no_copy": 1, "print_hide": 1}
 ],
 "field_order": [
  "identity_section",
  "item_code",
  "image",
  "company",
  "bom",
  "supplier_product_code",
  "supplier",
  "material",
  "specification",
  "product_name",
  "stock_uom",
  "legacy_section",
  "legacy_number",
  "legacy_code",
  "display_name",
  "display_uom",
  "legacy_remarks",
  "profile_image",
  "old_number",
  "major_category",
  "minor_category",
  "category",
  "category_detail",
  "brand",
  "style",
  "source",
  "design_section",
  "shared_version",
  "patent_number",
  "patent_image",
  "designer",
  "pattern_maker",
  "modeler",
  "owner_name",
  "region",
  "pricing_section",
  "list_price",
  "blank_price",
  "weight",
  "silver_weight",
  "stone_weight",
  "inactive",
  "notes",
  "recipe_section",
  "requirements",
  "packaging",
  "materials",
  "operations",
  "material_unit_cost",
  "processing_unit_cost",
  "request_id",
  "request_digest",
  "creation_mode"
 ],
 "search_fields": "item_code,supplier_product_code,old_number,major_category,minor_category,patent_number,specification",
 "allow_import": 1
}
